# ========================
# MS SQL SERVER
# ========================
SQL_SERVER=localhost
SQL_DATABASE=EsportsLeagueDB
SQL_USER=sa
SQL_PASSWORD=your_sql_password_here
SQL_PORT=1433

# ========================
# MONGODB
# ========================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/esports_league?retryWrites=true&w=majority

# ========================
# JWT
# ========================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ========================
# SERVER
# ========================
PORT=5000
NODE_ENV=development
